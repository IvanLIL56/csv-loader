# ──────────────────────────────────────────────
# Конфигурация CSV-to-PostgreSQL Loader
# ──────────────────────────────────────────────

# Путь к корневой директории с CSV-файлами (ОБЯЗАТЕЛЬНО)
ROOT_DIR=/home/trx/PycharmProjects/fidi/tests

# Строка подключения к PostgreSQL (ОБЯЗАТЕЛЬНО)
# Формат: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://USER:12345678@localhost:5433/mydb

# Количество потоков-воркеров (опционально, по умолчанию: 4)
WORKERS=4

# Размер батча для вставки строк (опционально, по умолчанию: 1000)
BATCH_SIZE=1000

# Уровень логирования: DEBUG, INFO, WARNING, ERROR (опционально, по умолчанию: INFO)
LOG_LEVEL=INFO

# Паттерн для фильтрации файлов (опционально, по умолчанию: *.csv)
# Поддерживает glob-синтаксис: *.csv, data_*.csv, report_???.csv
FILE_PATTERN=*.csv